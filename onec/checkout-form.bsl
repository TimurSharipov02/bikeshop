// Модуль основной управляемой формы обработки ВелотерраКасса.
// Реквизиты обработки внутри Объект: НомерОбращения (Строка 40),
// Ключ1С (Строка 128), Сводка (Строка 0, многострочная),
// ИдентификаторРасчета (Строка 64), СуммаКОплате (Число 15,2),
// ФН (Строка 20), ФД (Строка 20), ФП (Строка 20),
// ЧекПробитИСверен (Булево).
// Команды формы: ПолучитьОбращение, ПодтвердитьЧек.
// Оплату и фискализацию кассир выполняет штатными средствами УНФ.

&НаКлиенте
Процедура ПолучитьОбращение(Команда)
	// Реквизиты прежнего обращения нельзя случайно использовать при сбое загрузки.
	Объект.ИдентификаторРасчета = "";
	Объект.СуммаКОплате = 0;
	Объект.Сводка = "";
	Объект.ЧекПробитИСверен = Ложь;
	Объект.ФН = "";
	Объект.ФД = "";
	Объект.ФП = "";
	Если ПустаяСтрока(СокрЛП(Объект.НомерОбращения)) Тогда
		Предупреждение("Укажи номер обращения из приложения");
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(Объект.Ключ1С)) Тогда
		Предупреждение("Укажи ключ обмена с сайтом");
		Возврат;
	КонецЕсли;
	Попытка
		ДанныеРасчета = ЗагрузитьОбращениеНаСервере(СокрЛП(Объект.НомерОбращения), Объект.Ключ1С);
		Объект.Сводка = ДанныеРасчета.Сводка;
		Объект.СуммаКОплате = ДанныеРасчета.Сумма;
		Объект.ИдентификаторРасчета = ДанныеРасчета.Идентификатор;
	Исключение
		Объект.Сводка = "Ошибка загрузки: " + ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьЧек(Команда)
	Если ПустаяСтрока(Объект.ИдентификаторРасчета) Тогда
		Предупреждение("Сначала получи обращение с сайта");
		Возврат;
	КонецЕсли;
	Если Не Объект.ЧекПробитИСверен Тогда
		Предупреждение("Сверь сумму и состав с пробитым чеком ККМ в УНФ");
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(Объект.ФН)) Или ПустаяСтрока(СокрЛП(Объект.ФД))
		Или ПустаяСтрока(СокрЛП(Объект.ФП)) Тогда
		Предупреждение("Заполни ФН, ФД и ФП с копии пробитого чека");
		Возврат;
	КонецЕсли;
	Если Вопрос("Подтвердить в приложении уже оплаченный чек на "
		+ Строка(Объект.СуммаКОплате) + " руб.?",
		РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Результат = ПодтвердитьЧекНаСервере(
			СокрЛП(Объект.НомерОбращения), Объект.ИдентификаторРасчета,
			Объект.СуммаКОплате, СокрЛП(Объект.ФН), СокрЛП(Объект.ФД),
			СокрЛП(Объект.ФП), Объект.Ключ1С);
		Объект.Сводка = Объект.Сводка + Символы.ПС
			+ "ОПЛАТА ПОДТВЕРЖДЕНА НА САЙТЕ";
		Объект.ИдентификаторРасчета = "";
		Объект.ЧекПробитИСверен = Ложь;
	Исключение
		// Чек уже пробит: при ошибке сети повторить только подтверждение.
		Предупреждение("Чек в УНФ не повторяй. Подтверждение на сайте: "
			+ ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодтвердитьЧекНаСервере(Номер, Идентификатор, Сумма, ФН, ФД, ФП, Ключ)
	Соединение = Новый HTTPСоединение("bikeshop-chi.vercel.app", 443, , , , 15,
		Новый ЗащищенноеСоединениеOpenSSL);
	Тело = Новый Структура;
	Тело.Вставить("number", Номер);
	Тело.Вставить("quoteId", Идентификатор);
	Тело.Вставить("total", Сумма);
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("fn", ФН);
	Реквизиты.Вставить("fd", ФД);
	Реквизиты.Вставить("fp", ФП);
	Тело.Вставить("receipt", Реквизиты);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Тело);
	Текст = Запись.Закрыть();
	Запрос = Новый HTTPЗапрос("/api/1c-checkout");
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Запрос.Заголовки.Вставить("X-1C-Key", Ключ);
	Запрос.УстановитьТелоИзСтроки(Текст, КодировкаТекста.UTF8);
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "Сайт вернул " + Строка(Ответ.КодСостояния)
			+ ": " + Лев(Ответ.ПолучитьТелоКакСтроку(), 500);
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Результат = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Если ТипЗнч(Результат) <> Тип("Структура")
		Или Не Результат.Свойство("ok") Тогда
		ВызватьИсключение "Неожиданный ответ сайта после отправки чека";
	КонецЕсли;
	Если Результат.ok <> Истина Тогда
		ВызватьИсключение "Сайт не подтвердил оплату";
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ЗагрузитьОбращениеНаСервере(Номер, Ключ)
	Соединение = Новый HTTPСоединение("bikeshop-chi.vercel.app", 443, , , , 15,
		Новый ЗащищенноеСоединениеOpenSSL);
	Путь = "/api/1c-checkout?number="
		+ КодироватьСтроку(Номер, СпособКодированияСтроки.КодировкаURL);
	Запрос = Новый HTTPЗапрос(Путь);
	Запрос.Заголовки.Вставить("X-1C-Key", Ключ);
	Ответ = Соединение.Получить(Запрос);
	Тело = Ответ.ПолучитьТелоКакСтроку();
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "Сайт вернул " + Строка(Ответ.КодСостояния)
			+ ": " + Лев(Тело, 500);
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Тело);
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Если ТипЗнч(Данные) <> Тип("Структура") Или Не Данные.Свойство("order") Тогда
		ВызватьИсключение "Неожиданный ответ сайта";
	КонецЕсли;
	Обращение = Данные.order;
	Если ТипЗнч(Обращение) <> Тип("Структура")
		Или Не Обращение.Свойство("quoteId")
		Или Не Обращение.Свойство("total")
		Или СтрДлина(Обращение.quoteId) <> 64 Тогда
		ВызватьИсключение "Сайт не вернул точную сумму и идентификатор расчёта";
	КонецЕсли;
	Текст = "Обращение " + Обращение.number + Символы.ПС
		+ "Клиент: " + Обращение.clientName + Символы.ПС
		+ "Велосипед: " + Обращение.bikeName + Символы.ПС;
	Для Каждого Работа Из Обращение.laborLines Цикл
		Если ПустаяСтрока(Работа.serviceBarcode) Тогда
			ВызватьИсключение "Не указан штрихкод услуги для мастера " + Работа.masterName;
		КонецЕсли;
		Текст = Текст + "Работа " + Работа.masterName + " ["
			+ Работа.serviceBarcode + "]: " + Строка(Работа.amount) + " руб." + Символы.ПС;
	КонецЦикла;
	Для Каждого Запчасть Из Обращение.parts Цикл
		Текст = Текст + "Запчасть " + Запчасть.name + " ["
			+ Запчасть.sku + "] " + Строка(Запчасть.qty) + " x "
			+ Строка(Запчасть.price) + " руб." + Символы.ПС;
	КонецЦикла;
	Если Обращение.unallocatedPartsSum > 0 Тогда
		Текст = Текст + "СОПОСТАВИТЬ ДЕТАЛИ БЕЗ НОМЕНКЛАТУРЫ: "
			+ Строка(Обращение.unallocatedPartsSum) + " руб." + Символы.ПС;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("Сводка", Текст + "ИТОГО: " + Строка(Обращение.total) + " руб.");
	Результат.Вставить("Сумма", Обращение.total);
	Результат.Вставить("Идентификатор", Обращение.quoteId);
	Возврат Результат;
КонецФункции
